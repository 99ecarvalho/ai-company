# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env (docker-compose convention: .env at the root)
.env
.env.local
.env.old
.env.bak

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Claude Code
.claude/settings.local.json

# Playwright
.playwright-mcp/

# docker-compose.override.yml is generated by framework/scripts/reconcile.py
docker-compose.override.yml

# Optional local (personal) context overlay; the framework reads it if present
CLAUDE.local.md

# === State/config of the user company (instance/) ===
# Everything here belongs to the instance, not the framework. Populated during
# initial setup (bootstrap-env + reconcile) and while the agents run.
instance/

# Local meta-development notes (PROJECT_PLAN, DECISIONS,
# EXECUTION_LOG, QUESTIONS). Optional; if kept, they stay out of the repo.
.dev/

# === Frontend SvelteKit (framework/web/) ===
# node_modules and build artifacts; sources in frontend/src/ are tracked.
framework/web/frontend/node_modules/
framework/web/frontend/.svelte-kit/
framework/web/build/

# Playwright artifacts (already ignored in frontend/.gitignore, but the root needs it too)
framework/web/frontend/test-results/
framework/web/frontend/playwright-report/
