# ============================================================================
# agent-framework — .env.sample
# ============================================================================
# Copie para .env na raiz do repo e preencha os campos obrigatorios.
# NUNCA commite o .env real (ja esta no .gitignore).
#
# Bootstrap automatico:
#   bash framework/scripts/bootstrap-env.sh
# Ele gera .env com secrets aleatorios e valores default.
# ============================================================================

# --- Postgres (storage unico: messaging, memory, telemetry, orchestrator) ---
POSTGRES_DB=agent_framework
POSTGRES_USER=agent_framework
POSTGRES_PASSWORD=              # OBRIGATORIO — gerado via: openssl rand -hex 32

# --- Admin (humano principal da instancia) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                 # plaintext; web bcrypta no startup

# --- Auth mode ---
# DEV: 1 = admin implicito sem cookie/token (single-user local)
# PROD: vazio + ADMIN_PASSWORD setado = forca login
WEB_AUTH_DEV_BYPASS=1
WEB_COOKIE_SECURE=              # 1 = forca cookies Secure (requer HTTPS)

# Stream pre-selecionada no PWA CapturePanel (dropdown de destino)
WEB_DEFAULT_STREAM=

# --- Service tokens (auth interna entre daemons) ---
# Gere com: openssl rand -hex 32
ORCHESTRATOR_TOKEN=
SCHEDULER_TOKEN=

# --- VAPID (web push notifications) ---
# Gere via: python framework/scripts/generate-vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Transcriber (faster-whisper — speech-to-text) ---
WHISPER_MODEL=large-v3          # tiny|base|small|medium|large-v2|large-v3|distil-large-v3
WHISPER_DEVICE=cuda             # cuda|cpu
WHISPER_COMPUTE_TYPE=float16    # float16|int8_float16|int8|float32
WHISPER_LANGUAGE=               # vazio = auto-detect; ou: pt, en, es, ...

# --- TTS (Piper — text-to-speech) ---
DEFAULT_VOICE=pt_BR-faber-medium
# PIPER_VOICES_DIR=/voices      # dentro do container; nao altere a menos que saiba

# --- Timezone (todos os containers) ---
TZ=America/Sao_Paulo

# --- Deploy: multi-empresa na mesma maquina ---
COMPOSE_PROJECT_NAME=company-agents
WEB_PORT=9090

# --- Paths (bind-mounts no host) ---
REPOS_DIR=./instance/repos
SESSIONS_DIR=./instance/sessions
# AGENTS_DIR=./instance/agents
# COMPANY_DIR=./instance/company
# BACKUPS_DIR=./instance/backups

# --- BYOI / Docker registry privado ---
# mkdir .docker && DOCKER_CONFIG=./.docker docker login <registry>
DOCKER_CONFIG=

# --- Git push / MR-PR ---
GITLAB_TOKEN=
GITLAB_HOST=                    # vazio = gitlab.com; preencha se self-hosted
GH_TOKEN=
GIT_AUTHOR_NAME=agent-framework
GIT_AUTHOR_EMAIL=agents@local

# --- Banco de producao read-only (capability mysql-producao, opcional) ---
DB_PROD_HOST=
DB_PROD_PORT=3306
DB_PROD_USER=
DB_PROD_PASS=
DB_PROD_NAME=

# --- Stream agregador (notificacoes terminais de task) ---
TERMINAL_NOTIFY_STREAM=

# --- Test mode (CI/Playwright) ---
CLAUDE_MOCK=                    # 1 = mock sem invocar Claude CLI
CLAUDE_MOCK_REPLY=

# --- PWA manifest ---
PWA_NAME=Agents
PWA_SHORT_NAME=Agents
PWA_DESCRIPTION=Multi-agent orchestration
PWA_THEME_COLOR=#0b1220
PWA_BACKGROUND_COLOR=#0b1220
PWA_ID=/agent-framework
PWA_LANG=en
PWA_START_URL=/
PWA_ORIENTATION=any
# INSTANCE_WEB_DIR=./instance/web

# --- Cloudflared tunnel (opcional) ---
# Expoe a PWA publicamente via Cloudflare edge (HTTPS auto, sem port-forward)
# Setup: zero-trust dashboard > tunnels > copie o connector token
CF_TUNNEL_TOKEN=
# Descomente pra incluir cloudflared automaticamente em todo `up -d`:
# COMPOSE_PROFILES=tunnel
