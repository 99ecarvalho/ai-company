# system_prompts/config.yaml — toggles globais do system prompt.
#
# Cada flag controla se uma secao eh injetada via --append-system-prompt no
# `claude -p` de TODOS os agentes. claude_runner re-le este arquivo a cada
# invocacao — edicoes valem na proxima task, sem restart.
#
# Editavel pelo PWA (Empresa > System Prompts) ou diretamente neste arquivo.

include_platform_prompt: true       # system_prompts/platform.md (regras invariantes)
include_company_context: true       # company/CONTEXT.md
include_company_philosophy: true    # company/philosophy.md
include_agent_claude_md: true       # agents/<nome>/CLAUDE.md (identidade)
include_team_block: true            # bloco "## Equipe" gerado dinamicamente do DB
# Blocos dinamicos contextuais (D-110+):
include_invocation_context: true    # "## Modo de invocacao" — raiz vs filha + nome do pai
include_task_state: true            # "## Estado da task" — snapshot quando topic eh task-*
include_step_instructions: true     # "## Instrucoes da fase atual" — workflows.yaml step.instructions
