# system_prompts/config.yaml — global toggles for the system prompt.
#
# Each flag controls whether a section is injected via --append-system-prompt
# on `claude -p` for ALL agents. claude_runner re-reads this file on every
# invocation — edits take effect on the next task, no restart.
#
# Editable from the PWA (Settings > System Prompts) or directly in this file.

include_platform_prompt: true       # framework-fixed platform.md (read-only, ships in agent/web images)
include_company_context: true       # company/CONTEXT.md
include_company_philosophy: true    # company/philosophy.md
include_agent_claude_md: true       # agents/<name>/CLAUDE.md (identity)
include_team_block: true            # "## Team" block generated dynamically from the DB
# Dynamic contextual blocks (D-110+):
include_invocation_context: true    # "## Invocation mode" — root vs child + parent name
include_task_state: true            # "## Task state" — snapshot when topic is task-*
include_step_instructions: true     # "## Current phase instructions" — workflows.yaml step.instructions
