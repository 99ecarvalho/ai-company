# agents.yaml.example — MINIMAL annotated TEMPLATE for your company.
#
# Copy this to agents.yaml (bootstrap does it for you), edit, and run:
#   make reconcile        # or: ./run.sh reconcile
#
# It ships 5 example agents covering the example workflows — feel free to
# use them as reference, but they're not mandatory. Start from scratch here
# if you want.

schema_version: 1

# ==== Claude Code HOOKS (optional, passthrough to settings.json) ============
# Hooks are shell commands that run at lifecycle points of Claude Code
# (PreToolUse, PostToolUse, Stop, SessionStart, etc). See:
#   https://code.claude.com/docs/en/hooks-guide
#
# Two levels: `hooks_defaults` (here, applied to every agent) + per-agent
# `hooks` (concatenated to defaults per event). Each hooks group is preserved
# intact — Claude Code handles matchers independently.
#
# Gotchas:
# - Referenced scripts must be reachable INSIDE the container.
#   Two conventions:
#     (a) Shared: copy to instance/hooks/*.sh — they end up at /app/hooks/ (ro)
#         via bind mount on every agent. Use this for policy hooks
#         (blocks, auditing, global formatters).
#     (b) Per-agent: instance/agents/<name>/hooks/*.sh — they end up at
#         /app/agents/<name>/hooks/ via the agent home bind mount.
# - `jq` and `yq` are already in the agent image.
# - Editing settings.json only requires `make reconcile` + agent restart
#   (no image rebuild — no Python touched).
#
# Active example below: block-push-main blocks agents from running `git push`
# against main/master (forces a branch + MR/PR). Copy the generic script from
# the framework into your instance with:
#   cp framework/examples/hooks/block-push-main.sh instance/hooks/
#
# This hook does NOT affect `git push` from the host — only Bash invoked by
# agents. To disable it for an emergency task, edit here + make reconcile +
# docker compose restart <agent>.
hooks_defaults:
  PreToolUse:
    - matcher: "Bash"
      hooks:
        - type: command
          command: "/app/hooks/block-push-main.sh"

# ==== CAPABILITY INSTANCES (optional) ============================
# Parameterized instances of MCP capabilities. Each instance:
#   - has a unique name — becomes the MCP namespace (`mcp__<name>__*`) and
#     the server in mcp.extra.json. Agents consume it in `capabilities`.
#   - points at a framework template (CAPABILITY_TEMPLATES in
#     framework/scripts/reconcile.py).
#   - declares `env`: a mapping of env vars the MCP server reads. Values
#     are Compose template strings (`${VAR:-default}`), expanded when the
#     agent container starts.
#
# Allows multiple instances of the same template (mysql-prod + mysql-staging)
# with different creds. With no instances declared, this block is empty/omitted —
# the install uses singletons only.
#
# capability_instances:
#   mysql-prod:
#     template: mysql                  # @benborla29/mcp-server-mysql, stdio
#     env:
#       MYSQL_HOST: "${DB_PROD_HOST:-}"
#       MYSQL_PORT: "${DB_PROD_PORT:-3306}"
#       MYSQL_USER: "${DB_PROD_USER:-}"
#       MYSQL_PASS: "${DB_PROD_PASS:-}"
#       MYSQL_DB:   "${DB_PROD_NAME:-}"

# ==== TOOLS shared by every agent ================================
# `allowed_tools_defaults` is prepended to each agent's own allowed_tools
# (an agent opts out with `inherit_tool_defaults: false`). Items written as
# `group:<name>` expand to a group of tools; built-in groups:
#   files     Read, Write, Edit, Glob, Grep
#   web       WebFetch, WebSearch
#   human     ask_human, notify_human
#   agents    ask_agent, ask_agents_many
#   workflow  complete_phase, get_task_state
#   tasks     task_list, reopen_task
#   worktree  init_repo, create_worktree, cleanup_worktrees
#   memory    memory_save, memory_recall, memory_list, memory_edit, memory_delete
#   backlog   backlog_add, backlog_list, backlog_update, backlog_promote
#   scheduler schedule_add, schedule_list, schedule_update, schedule_remove
#   skills    save_skill, list_skills, delete_skill
# (all MCP ones are mcp__ai_company__<tool>). Add your own, or override a
# built-in, with `tool_groups:`:
#
# tool_groups:
#   reporting: [group:files, group:web, mcp__sentry__list_issues]
allowed_tools_defaults:
  - group:files
  - group:human
  - group:agents
  - group:workflow                    # every example agent takes part in workflows
  - group:memory

agents:

  # ============================================================
  # FULL EXAMPLE: 5 agents covering the workflows shipped in
  # workflows.yaml.example (`default` and `research`).
  # Each agent covers a distinct role. Remove/adjust to fit the
  # roles your company actually needs. Each one lists only the tools
  # it needs beyond allowed_tools_defaults.
  # ============================================================

  # ==== triager: first contact, classifies + closes ====
  # Appears in: default (intake, wrap), research (intake, wrap).
  - name: triager
    display_name: "Triager"
    description: "Initial task triage and wrap-up."
    streams: [triager]
    pool_size: 3
    idle_timeout_sec: 900
    write_access: [company, orchestrator]
    read_access: [repos]              # reads code only to understand context
    model: sonnet                     # triage and wrap-up don't need the biggest model
    effort: low
    memory: true

  # ==== planner: designs the approach before the build ====
  # Appears in: default (plan).
  - name: planner
    display_name: "Planner"
    description: "Designs technical plans and architecture before implementation."
    streams: [planner]
    pool_size: 2
    idle_timeout_sec: 1800
    write_access: [company, orchestrator]
    read_access: [repos]
    model: opus                       # planning benefits from more capacity
    effort: high
    memory:
      enabled: true
      auto_inject_limit: 8            # planner accumulates a lot of technical context

  # ==== executor: implements in code (Bash + worktrees) ====
  # Appears in: default (build — agent omitted from the workflow,
  # planner passes next_agent=executor explicitly).
  - name: executor
    display_name: "Executor"
    description: "Implements technical tasks in repos/ via worktrees."
    streams: [executor]
    pool_size: 1                      # serializes — avoids merge conflicts
    idle_timeout_sec: 3600
    write_access: [repos, company, orchestrator]   # repos => worktrees mounted read-write
    read_access: []
    model: opus
    effort: high
    memory:
      enabled: true
      auto_inject_limit: 8
    # main_repo: core                 # (optional) See the "main_repo" section in the REFERENCE below.
    # capabilities: [playwright]      # (optional) brings up side MCP servers.
                                      # Singletons in the framework: playwright, sentry.
                                      # Others: declare them as capability_instance at
                                      # the top of this file (template + env). When
                                      # enabling a capability, include the matching MCP
                                      # tools in allowed_tools (e.g.
                                      # mcp__playwright__*, mcp__<instance-name>__*).
    allowed_tools:
      - Bash
      - group:worktree                 # init_repo + create/cleanup worktrees
    # hooks:                              # (optional) per-agent hooks, concatenated with hooks_defaults
    #   PreToolUse:
    #     - matcher: "Bash"
    #       hooks:
    #         - type: command
    #           command: "/app/agents/executor/hooks/block-dangerous-bash.sh"

  # ==== reviewer: reviews what the executor produced ====
  # Appears in: default (review).
  - name: reviewer
    display_name: "Reviewer"
    description: "Reviews the code + tests produced by the executor."
    streams: [reviewer]
    pool_size: 2
    idle_timeout_sec: 1800
    write_access: [company, orchestrator]
    read_access: [repos]              # reads repos to review; does not write to them
    worktree_access: rw               # runs the tests in the task's worktree, and
                                      # test runs write caches/build output there
    memory: true
    allowed_tools:
      - Bash                           # runs tests/lint to verify

  # ==== researcher: investigation without code ====
  # Appears in: research (investigate).
  - name: researcher
    display_name: "Researcher"
    description: "Investigates questions that end in a document, without code."
    streams: [researcher]
    pool_size: 2
    idle_timeout_sec: 1800
    write_access: [company, orchestrator]
    read_access: [repos]
    memory: true
    allowed_tools:
      - group:web                      # search external docs

# === SCHEMA REFERENCE ===
#
# name (required)              lowercase slug, no spaces. Becomes the bot name + folder.
# display_name (required)      name shown in the UI.
# description (required)       one-liner about the role (appears in the default CLAUDE.md).
# streams                      [list] streams the bot listens to. Default: [name].
# pool_size                    concurrency (default 2).
# idle_timeout_sec             seconds without messages before releasing the slot (default 900).
# write_access                 [list] subset of {company, orchestrator, repos}.
# read_access                  [list] subset of {company, orchestrator, repos}.
# allowed_tools                [list] tools the agent may use without asking, on top
#                              of allowed_tools_defaults. Tool names (Read, Bash,
#                              mcp__ai_company__ask_human, mcp__playwright__*) or
#                              group:<name> (see "TOOLS shared by every agent").
#                              Keep ask_human (group:human) for agents that talk to
#                              people, group:workflow for workflow participants and
#                              group:memory for persistent memory.
# inherit_tool_defaults        Optional, default true. false = ignore
#                              allowed_tools_defaults for this agent.
# worktree_access              Optional. "rw" or "ro" for /workspace/worktrees (task
#                              worktrees). Default: rw when write_access has repos,
#                              ro otherwise, so only code-writing agents can change
#                              a task's code. Set rw for agents that run tests there.
# memory                       Long-term memory (per agent, in Postgres). Options:
#                                true                    (default — enabled, auto-inject 5)
#                                false                   (no memory)
#                                {enabled: bool, auto_inject_limit: int}
#                              auto_inject_limit=N: before each run, the framework
#                              fetches the N most relevant facts from memory and
#                              injects them into the prompt. Ensures Claude SEES
#                              the memory without relying on it remembering to
#                              call memory_recall.
# model                        Optional. Prefer an alias ("sonnet"/"opus"/"haiku"): it
#                              follows new releases. A full id ("claude-...") pins one
#                              release, and reconcile warns about it. Without this —
#                              uses the CLI default. Workflow steps can override it
#                              per step (overrides.model in workflows.yaml).
# effort                       Optional. "low"|"medium"|"high"|"xhigh"|"max". How much
#                              thinking/effort Claude invests (higher = more tokens).
# thinking                     Optional. true = shortcut for effort=high if effort
#                              isn't already set.
# capabilities                 [list] side tools provided via MCP. Each item brings
#                              up a shared side container and injects the server
#                              into the agent's mcp.extra.json. Known ones:
#                                playwright      — automated browser
#                                                  (headless Chromium). Add
#                                                  mcp__playwright__* to allowed_tools.
#
# main_repo                    (Optional) Name of a subfolder under /workspace/repos/
#                              whose `.claude/` should be exposed in the agent's
#                              session. E.g. main_repo: core -> mirrors
#                              /workspace/repos/core/.claude/{skills,agents,commands}/*
#                              into the session_dir via per-item symlink. Useful for
#                              agents "anchored" to a specific repo (analysts,
#                              consultative, DBA running queries against a repo's schema).
#
#                              Precedence on name collision: the agent's own
#                              `.claude/` (instance/agents/<name>/.claude/) wins over
#                              main_repo — allows local overrides.
#
#                              IMPORTANT CAVEAT — executors with a worktree:
#                              when an executor has EXACTLY ONE worktree
#                              registered for an `in_progress` task of theirs,
#                              ClaudeRunner spawns claude with CWD = the worktree
#                              path (not session_dir) for git/relative-path
#                              ergonomics and to load the repo's `CLAUDE.md`. On
#                              that path, main_repo's symlinks (and the agent's
#                              own `.claude/`) are NOT visible — the claude CLI
#                              only sees the `.claude/` committed in the worktree
#                              repo. The agent's own skills and main_repo only
#                              apply when CWD = session_dir (agent without
#                              worktree, agent with multiple worktrees, or
#                              non-executor agent).
#
#                              Configuring main_repo on an executor that spends
#                              most of its time inside a worktree isn't an error,
#                              but it doesn't deliver practical value — prefer
#                              anchoring it on analysts/consultative agents.
#                              E.g. capabilities: [playwright, sentry, mysql-prod]
#                              Capabilities resolve in two categories:
#                                - SINGLETONS in the framework (MCP_CAPABILITIES in
#                                  reconcile.py): playwright, sentry. Fixed config,
#                                  one per install.
#                                - INSTANCES in agents.yaml (capability_instances):
#                                  parameterized via framework templates
#                                  (CAPABILITY_TEMPLATES). E.g. declaring
#                                  `mysql-prod` pointing at the `mysql` template
#                                  with env-mapping for the .env's DB_PROD_*.
#                                  Allows multiple instances of the same template
#                                  (mysql-prod + mysql-staging with different creds).
#                              For a new non-parameterizable capability (singleton):
#                              edit MCP_CAPABILITIES in framework/scripts/reconcile.py.
#                              For a new template (parameterizable): add it to
#                              CAPABILITY_TEMPLATES in the same file, then declare
#                              instances under capability_instances here.
# image                        (BYOI) Docker image override. When set, the framework
#                              does NOT build it — the user provides a ready image.
#                              Accepts any repo/tag. For private registries:
#                              run `docker login` on the host (or see DOCKER_CONFIG
#                              in .env). The external image MUST extend
#                              framework/docker/agent.Dockerfile (it needs the
#                              Python runner + Claude CLI + standard entrypoint).
#                              E.g. image: registry.gitlab.com/acme/my-php-agent:v1
#
# hooks                        [dict] Claude Code hooks (passthrough to
#                              .claude/settings.json). See the commented block at
#                              the top of this file. Merges with top-level
#                              `hooks_defaults`: per-event lists are concatenated
#                              (defaults first, per-agent after). Structurally
#                              validated (event -> list of groups); event names
#                              and hook types are validated by the CLI on load.
#
# Optional integration fields (future):
#   env                        [dict] custom env vars passed to the container
