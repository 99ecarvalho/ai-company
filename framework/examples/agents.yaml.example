# agents.yaml.example — TEMPLATE MINIMO comentado pra sua empresa.
#
# Copia isso pra agents.yaml, edita, e roda:
#   ./scripts/reconcile.sh
#
# O agents.yaml atual (sem .example) tem 7 agentes de exemplo — podem servir
# de referencia mas nao sao obrigatorios. Comece do zero aqui se quiser.

schema_version: 1

# ==== HOOKS do Claude Code (opcional, passthrough pra settings.json) ========
# Hooks sao shell commands que rodam em pontos da lifecycle do Claude Code
# (PreToolUse, PostToolUse, Stop, SessionStart, etc). Ver:
#   https://code.claude.com/docs/en/hooks-guide
#
# Dois niveis: `hooks_defaults` (aqui, aplica a todos os agentes) + `hooks`
# por agente (concatenado aos defaults por evento). Cada grupo de hooks e
# preservado intacto — Claude Code trata matchers independentemente.
#
# Gotchas:
# - Scripts referenciados precisam estar acessiveis DENTRO do container.
#   Duas convencoes:
#     (a) Shared: copie pra instance/hooks/*.sh — ficam em /app/hooks/ (ro)
#         via bind mount em todos os agentes. Use pra hooks de politica
#         (bloqueios, auditoria, formatters globais).
#     (b) Per-agent: instance/agents/<nome>/hooks/*.sh — ficam em
#         /app/agents/<nome>/hooks/ via bind-mount do agent home.
# - `jq` e `yq` ja estao na imagem agent.
# - Edit em settings.json so precisa de `make reconcile` + restart do agente
#   (nao precisa rebuild de imagem — nao mexe em Python).
#
# Exemplo ativo abaixo: block-push-main bloqueia agentes de fazer `git push`
# contra main/master (forca branch + MR/PR). Copie o script generico do
# framework pra sua instance com:
#   cp framework/examples/hooks/block-push-main.sh instance/hooks/
#
# Esse hook nao afeta `git push` direto do host — so vale pra Bash chamado
# pelos agentes. Se quiser desativar em alguma task de emergencia, edite
# aqui + make reconcile + docker compose restart <agente>.
hooks_defaults:
  PreToolUse:
    - matcher: "Bash"
      hooks:
        - type: command
          command: "/app/hooks/block-push-main.sh"

# ==== CAPABILITY INSTANCES (opcional) ============================
# Instancias parametrizadas de capabilities MCP. Cada instance:
#   - tem nome unico — vira o namespace MCP (`mcp__<name>__*`) e o
#     server em mcp.extra.json. Agentes consomem em `capabilities`.
#   - aponta pra um template do framework (CAPABILITY_TEMPLATES em
#     framework/scripts/reconcile.py).
#   - declara `env`: mapping de env vars que o MCP server le. Values
#     sao template-strings Compose (`${VAR:-default}`), expandidas
#     ao subir o container do agente.
#
# Permite multiplas instancias do mesmo template (mysql-producao +
# mysql-staging) com creds distintas. Sem instances declaradas, esse
# bloco fica vazio/omitido — instalacao usa so singletons.
#
# capability_instances:
#   mysql-producao:
#     template: mysql                  # @benborla29/mcp-server-mysql, stdio
#     env:
#       MYSQL_HOST: "${DB_PROD_HOST:-}"
#       MYSQL_PORT: "${DB_PROD_PORT:-3306}"
#       MYSQL_USER: "${DB_PROD_USER:-}"
#       MYSQL_PASS: "${DB_PROD_PASS:-}"
#       MYSQL_DB:   "${DB_PROD_NAME:-}"

agents:

  # ============================================================
  # EXEMPLO COMPLETO: 5 agentes que cobrem os workflows shipados
  # em workflows.yaml.example (`default` e `research`).
  # Cada agente cobre um papel distinto. Remova/ajuste conforme
  # os papeis que sua empresa precisa.
  # ============================================================

  # ==== triager: primeiro contato, classifica + encerra ====
  # Aparece em: default (intake, wrap), research (intake, wrap).
  - name: triager
    display_name: "Triager"
    description: "Triagem inicial das tasks e encerramento (wrap-up)."
    streams: [triager]
    pool_size: 3
    idle_timeout_sec: 900
    write_access: [company, orchestrator]
    read_access: [repos]              # le codigo so pra entender contexto
    memory: true
    allowed_tools:
      - Read
      - Write
      - Edit
      - Glob
      - Grep
      - mcp__agent_framework__ask_human
      - mcp__agent_framework__ask_agent
      - mcp__agent_framework__complete_phase    # participa do workflow
      - mcp__agent_framework__get_task_state
      - mcp__agent_framework__memory_save
      - mcp__agent_framework__memory_recall
      - mcp__agent_framework__memory_list
      - mcp__agent_framework__memory_edit
      - mcp__agent_framework__memory_delete

  # ==== planner: desenha o approach antes do build ====
  # Aparece em: default (plan).
  - name: planner
    display_name: "Planner"
    description: "Desenha planos tecnicos e arquitetura antes da implementacao."
    streams: [planner]
    pool_size: 2
    idle_timeout_sec: 1800
    write_access: [company, orchestrator]
    read_access: [repos]
    model: opus                       # planejamento se beneficia de mais capacidade
    effort: high
    memory:
      enabled: true
      auto_inject_limit: 8            # planner acumula muito contexto tecnico
    allowed_tools:
      - Read
      - Write
      - Edit
      - Glob
      - Grep
      - mcp__agent_framework__ask_human
      - mcp__agent_framework__ask_agent
      - mcp__agent_framework__complete_phase
      - mcp__agent_framework__get_task_state
      - mcp__agent_framework__memory_save
      - mcp__agent_framework__memory_recall
      - mcp__agent_framework__memory_list
      - mcp__agent_framework__memory_edit
      - mcp__agent_framework__memory_delete

  # ==== executor: implementa em codigo (Bash + worktrees) ====
  # Aparece em: default (build — agente omitido no workflow,
  # planner passa next_agent=executor explicitamente).
  - name: executor
    display_name: "Executor"
    description: "Implementa tarefas tecnicas em repos/ via worktrees."
    streams: [executor]
    pool_size: 1                      # serializa — evita conflito de merge
    idle_timeout_sec: 3600
    write_access: [repos, company, orchestrator]
    read_access: []
    model: opus
    effort: high
    memory:
      enabled: true
      auto_inject_limit: 8
    # main_repo: core                 # (opcional) Ver secao "main_repo" na REFERENCIA abaixo.
    # capabilities: [playwright]      # (opcional) sobe MCP servers laterais.
                                      # Singletons no framework: playwright, sentry.
                                      # Outros: declare como capability_instance no
                                      # topo do arquivo (template + env). Ao habilitar
                                      # qualquer capability, inclua as tools MCP
                                      # correspondentes em allowed_tools (ex:
                                      # mcp__playwright__*, mcp__<instance-name>__*).
    allowed_tools:
      - Read
      - Write
      - Edit
      - Glob
      - Grep
      - Bash
      - mcp__agent_framework__ask_human
      - mcp__agent_framework__ask_agent
      - mcp__agent_framework__complete_phase
      - mcp__agent_framework__get_task_state
      - mcp__agent_framework__create_worktree   # isola task em worktree
      - mcp__agent_framework__cleanup_worktrees # limpa no fim
      - mcp__agent_framework__memory_save
      - mcp__agent_framework__memory_recall
      - mcp__agent_framework__memory_list
      - mcp__agent_framework__memory_edit
      - mcp__agent_framework__memory_delete
    # hooks:                              # (opcional) hooks per-agent, concatena com hooks_defaults
    #   PreToolUse:
    #     - matcher: "Bash"
    #       hooks:
    #         - type: command
    #           command: "/app/agents/executor/hooks/block-dangerous-bash.sh"

  # ==== reviewer: revisa o que o executor produziu ====
  # Aparece em: default (review).
  - name: reviewer
    display_name: "Reviewer"
    description: "Revisa codigo + testes produzidos pelo executor."
    streams: [reviewer]
    pool_size: 2
    idle_timeout_sec: 1800
    write_access: [company, orchestrator]
    read_access: [repos]              # le repos pra revisar; nao escreve la
    memory: true
    allowed_tools:
      - Read
      - Write
      - Edit
      - Glob
      - Grep
      - Bash                           # roda testes/lint pra verificar
      - mcp__agent_framework__ask_human
      - mcp__agent_framework__ask_agent
      - mcp__agent_framework__complete_phase
      - mcp__agent_framework__get_task_state
      - mcp__agent_framework__memory_save
      - mcp__agent_framework__memory_recall
      - mcp__agent_framework__memory_list
      - mcp__agent_framework__memory_edit
      - mcp__agent_framework__memory_delete

  # ==== researcher: investigacao sem codigo ====
  # Aparece em: research (investigate).
  - name: researcher
    display_name: "Researcher"
    description: "Investiga questoes que terminam em documento, sem codigo."
    streams: [researcher]
    pool_size: 2
    idle_timeout_sec: 1800
    write_access: [company, orchestrator]
    read_access: [repos]
    memory: true
    allowed_tools:
      - Read
      - Write
      - Edit
      - Glob
      - Grep
      - WebFetch                       # pesquisa em docs externas
      - WebSearch
      - mcp__agent_framework__ask_human
      - mcp__agent_framework__ask_agent
      - mcp__agent_framework__complete_phase
      - mcp__agent_framework__get_task_state
      - mcp__agent_framework__memory_save
      - mcp__agent_framework__memory_recall
      - mcp__agent_framework__memory_list
      - mcp__agent_framework__memory_edit
      - mcp__agent_framework__memory_delete

# === REFERENCIA do schema ===
#
# name (obrigatorio)            slug lowercase, sem espacos. Vira o bot e a pasta.
# display_name (obrigatorio)    nome exibido na UI.
# description (obrigatorio)     uma linha sobre o papel (aparece no CLAUDE.md padrao).
# streams                       [lista] streams escutados pelo bot. Default: [name].
# pool_size                     concorrencia (default 2).
# idle_timeout_sec              segundos sem msg antes de liberar o slot (default 900).
# write_access                  [lista] subset de {company, orchestrator, repos}.
# read_access                   [lista] subset de {company, orchestrator, repos}.
# allowed_tools                 [lista] sempre inclua mcp__agent_framework__ask_human.
#                               Inclua complete_phase se participa de workflows.
#                               Inclua memory_save/recall/list/edit/delete pra usar
#                               memoria persistente (edit/delete permitem corrigir
#                               ou remover memorias ficadas desatualizadas).
# memory                        Memoria LP (SQLite por agente). Opcoes:
#                                 true                    (default — enabled, auto-inject 5)
#                                 false                   (sem memoria)
#                                 {enabled: bool, auto_inject_limit: int}
#                               auto_inject_limit=N: antes de cada run, o framework
#                               busca os N fatos mais relevantes da memoria e injeta
#                               no prompt. Garante que o Claude VEJA a memoria sem
#                               depender dele lembrar de chamar memory_recall.
# model                         Opcional. Alias ("sonnet"/"opus"/"haiku") ou nome
#                               completo ("claude-sonnet-4-6"). Sem — usa default do CLI.
# effort                        Opcional. "low"|"medium"|"high"|"xhigh"|"max". Quanto
#                               thinking/esforco o Claude investe (mais alto = mais token).
# thinking                      Opcional. true = atalho pra effort=high se effort
#                               nao estiver setado.
# capabilities                  [lista] tools laterais providas via MCP. Cada item
#                               sobe um container lateral compartilhado e injeta o
#                               server no mcp.extra.json do agente. Conhecidas:
#                                 playwright      — navegador automatizado
#                                                   (Chromium headless). Adicione
#                                                   mcp__playwright__* em allowed_tools.
#
# main_repo                     (Opcional) Nome de uma subpasta de /workspace/repos/
#                               cujo `.claude/` deve ser exposto na sessao do agente.
#                               Ex: main_repo: core  -> espelha
#                               /workspace/repos/core/.claude/{skills,agents,commands}/*
#                               dentro do session_dir via per-item symlink. Util pra
#                               agentes "ancorados" num repositorio (analistas,
#                               consultivos, DBA que roda query no schema de um repo).
#
#                               Precedencia em caso de nome igual: o `.claude/` do
#                               proprio agente (instance/agents/<name>/.claude/) vence
#                               sobre main_repo — permite override local.
#
#                               CAVEAT IMPORTANTE — executores com worktree:
#                               quando um executor tem EXATAMENTE UMA worktree
#                               registrada pra uma task `in_progress` sua, o
#                               ClaudeRunner spawna o claude com CWD = path da
#                               worktree (nao session_dir) pra ergonomia de git/
#                               paths relativos e pra carregar `CLAUDE.md` do repo.
#                               Nesse caminho os symlinks do main_repo (e do
#                               `.claude/` do proprio agente) NAO sao visiveis — o
#                               claude CLI so ve `.claude/` comitado no repo da
#                               worktree. Skills proprias do agente e main_repo
#                               so valem quando CWD = session_dir (agente sem
#                               worktree, agente com multiplas worktrees, ou
#                               agente nao-executor).
#
#                               Configurar main_repo num executor que passa a
#                               maior parte do tempo dentro de worktree nao erra,
#                               mas nao entrega valor pratico — prefira ancorar
#                               nos analistas/consultivos.
#                               Ex: capabilities: [playwright, sentry, mysql-producao]
#                               Capabilities resolvidas em duas categorias:
#                                 - SINGLETONS no framework (MCP_CAPABILITIES em
#                                   reconcile.py): playwright, sentry. Config fixa,
#                                   um por instalacao.
#                                 - INSTANCES no agents.yaml (capability_instances):
#                                   parametrizadas via templates do framework
#                                   (CAPABILITY_TEMPLATES). Ex: declarar
#                                   `mysql-producao` apontando pro template `mysql`
#                                   com env-mapping pras DB_PROD_* do .env.
#                                   Permite multiplas instancias do mesmo template
#                                   (mysql-producao + mysql-staging com creds distintas).
#                               Pra capability nova nao parametrizavel (singleton):
#                               edite MCP_CAPABILITIES em framework/scripts/reconcile.py.
#                               Pra template novo (parametrizavel): adicione em
#                               CAPABILITY_TEMPLATES no mesmo arquivo, depois declare
#                               instances em capability_instances aqui.
# image                         (BYOI) override da imagem Docker. Se informado, o
#                               framework NAO buila — usuario entrega imagem pronta.
#                               Aceita qualquer repo/tag. Pra registries privados:
#                               faca 'docker login' no host (ou veja DOCKER_CONFIG no
#                               .env). A imagem externa DEVE estender
#                               framework/docker/agent.Dockerfile (precisa do runner
#                               Python + Claude CLI + entrypoint padrao).
#                               Ex: image: registry.gitlab.com/acme/my-php-agent:v1
#
# hooks                         [dict] Hooks do Claude Code (passthrough pra
#                               .claude/settings.json). Ver bloco comentado no
#                               topo desse arquivo. Merge com `hooks_defaults`
#                               top-level: listas por evento sao concatenadas
#                               (defaults primeiro, per-agent depois). Validado
#                               estruturalmente (forma event->list de groups);
#                               nomes de evento e tipos de hook sao validados
#                               pelo CLI ao carregar.
#
# Campos opcionais de integracao (futuramente):
#   env                         [dict] env vars custom passadas pro container
