# Copy to .env at the repo root and fill in.
# Do not commit .env.

# --- Postgres (single storage: messaging, memory, telemetry, orchestrator, web) ---
POSTGRES_DB=agent_framework
POSTGRES_USER=agent_framework
POSTGRES_PASSWORD=

# --- Admin (instance's primary human) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=            # plaintext; web bcrypts on startup. Set this to enable login.

# --- PWA auth ---
# DEV: 1 keeps the admin implicit when there's no cookie/token (single-user local).
# PROD: leave empty + ADMIN_PASSWORD set to force login.
WEB_AUTH_DEV_BYPASS=1
# Cookies marked Secure (= require HTTPS). Set to 1 when serving over TLS.
WEB_COOKIE_SECURE=

# Stream pre-selected in the PWA's CapturePanel (destination dropdown). Arbitrary
# name per instance (e.g. coordinator, secretary, ops). Empty = the user picks
# explicitly; the frontend pre-selects nothing.
WEB_DEFAULT_STREAM=

# --- Service tokens (auth for internal daemons against the broker) ---
ORCHESTRATOR_TOKEN=        # generated at bootstrap (openssl rand -hex 32)
SCHEDULER_TOKEN=

# Push notifications (VAPID) and the default stream are configured from the PWA:
# Settings -> System. Persisted in web.app_settings (DB).

# --- Transcriber ---
# GPU opt-in via docker-compose.gpu.yml — auto-detected by install.sh based on
# nvidia-smi. Manual: set COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
# Hosts without the NVIDIA Container Toolkit: run
# framework/scripts/install-nvidia-toolkit.sh (Debian/Ubuntu, needs sudo).

# --- TTS (Piper) ---
# Voice used when a request has no voice. The ai-tts image ships pt_BR-faber-medium.
TTS_DEFAULT_VOICE=pt_BR-faber-medium

# --- Claude provider ---
# Model used by the PWA's hire/onboard draft generation. Empty = CLI default.
HIRE_MODEL=
# Azure AI Foundry: set these to run the Claude CLI through Azure instead of
# Anthropic directly. Injected into every agent by reconcile.
CLAUDE_CODE_USE_FOUNDRY=
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=

# --- Timezone applied to every container ---
TZ=America/Sao_Paulo

# --- Deploy: multiple companies on the same machine ---
# Each company = 1 independent folder (copy of the framework) with its own .env.
# COMPOSE_PROJECT_NAME namespaces containers/volumes/networks — lets multiple
# companies run side by side without collisions. WEB_PORT must be unique per company.
# Example with 3 companies: company-agents-a/:9090, -b/:9091, -c/:9092.
COMPOSE_PROJECT_NAME=company-agents
WEB_PORT=9090

# --- BYOI / Docker config (private registry) ---
# If any agent uses `image:` from a private registry, isolate credentials per
# company by pointing DOCKER_CONFIG at a local directory. Avoids collisions
# with other accounts logged into the same registry under ~/.docker/config.json.
#
# Setup: mkdir .docker && DOCKER_CONFIG=./.docker docker login <registry>
# install.sh does this automatically if you say you use BYOI.
DOCKER_CONFIG=

# --- Repos (code workspace consumed by agents) ---
# Host path that the framework mounts at /workspace/repos inside the containers.
# Default points to a folder under instance/, but the recommended pattern is to
# keep repos OUTSIDE the framework (e.g. ../gitlab, /var/repos, /mnt/nfs/repos)
# to avoid nesting multiple gits inside the same editor workspace.
REPOS_DIR=./instance/repos

# --- Sessions (runtime cwd per topic/task for each agent) ---
# Each agent runs in /workspace/sessions/<topic-slug>/ inside its container —
# briefing, intermediate data and final artifacts live there, tied to the task.
# Host layout: ${SESSIONS_DIR}/<agent-name>/<topic-slug>/. Can point outside the
# framework (separate disk, mounted volume) if you want to persist execution
# workspaces elsewhere — the web container mounts this path read-only to serve
# the files in the PWA.
SESSIONS_DIR=./instance/sessions

# --- Production MySQL (optional) ---
# Read-only credentials consumed via the MySQL capability_instance declared
# in instance/agents/agents.yaml (template `mysql`, runs stdio in-process via
# @benborla29/mcp-server-mysql). Fill these in only if some agent declares a
# capability_instance that maps these vars into the env.
DB_PROD_HOST=
DB_PROD_PORT=3306
DB_PROD_USER=
DB_PROD_PASS=
DB_PROD_NAME=

# --- Git push / MR-PR (used by executors and reviewer-tester) ---
# Injected into every agent by reconcile. Read-only/consultative agents simply
# never invoke git push — that discipline lives in each agent's CLAUDE.md. The
# agent image already ships `glab` (GitLab) and `gh` (GitHub), so the framework
# is host-agnostic: configure the token for whichever host your instance uses.
#
# GITLAB_TOKEN: personal access token with scopes `api` + `write_repository`
# GITLAB_HOST:  omit if gitlab.com; set it for self-hosted (e.g. gitlab.company.com)
# GH_TOKEN:     personal access token with scope `repo`
# GIT_AUTHOR_*: identity used in commits created by agents
GITLAB_TOKEN=
GITLAB_HOST=
GH_TOKEN=
GIT_AUTHOR_NAME=agent-framework
GIT_AUTHOR_EMAIL=agents@local

# Anti-push-main protection: see hooks_defaults in agents.yaml.example + the
# script framework/examples/hooks/block-push-main.sh. Blocks agents from
# pushing directly to main/master via Claude Code's PreToolUse hook — pushes
# from the host are unaffected (D-60, replaces the removed git pre-push hooks).

# --- Test mode: CLAUDE_MOCK=1 makes claude_runner return a scripted reply
# (without invoking the Claude CLI). CLAUDE_MOCK_REPLY customizes the text.
# Used by the Playwright suite (make test-e2e). Empty in production. ---
CLAUDE_MOCK=
CLAUDE_MOCK_REPLY=

# --- Aggregator stream for terminal task notifications
# (done/halt/human_review). Arbitrary name per instance (e.g. orchestration,
# ops, tasks-feed). Empty = the reactor posts only in the task's origin
# conversation; the aggregator stream doesn't exist. When set, web bootstrap
# creates the stream in postgres. ---
TERMINAL_NOTIFY_STREAM=

# --- Agents (one token per agent, populated by reconcile) ---
# AGENT_<NAME>_TOKEN=

# --- PWA (Progressive Web App) — dynamic manifest (D-94) ---
# App configuration when installed on a device (iOS Add to Home, Chrome
# Install). Read by the `web` container at runtime; changing requires
# `docker compose restart web` (no rebuild).
#
# Icons: drop `icon-192.png` and `icon-512.png` into
# `${INSTANCE_WEB_DIR}/icons/` (default: `./instance/web/icons/`).
# To point somewhere else (e.g. inside the instance's `company/`), redefine
# `INSTANCE_WEB_DIR=./company/web` in .env.
PWA_NAME=Agents
PWA_SHORT_NAME=Agents
PWA_DESCRIPTION=Multi-agent orchestration
PWA_THEME_COLOR=#0b1220
PWA_BACKGROUND_COLOR=#0b1220
PWA_ID=/agent-framework
PWA_LANG=en
PWA_START_URL=/
# Orientation when the installed PWA opens. Values: any (default),
# portrait, landscape, portrait-primary, landscape-primary, natural.
# To lock mobile in upright mode: PWA_ORIENTATION=portrait.
# Only takes effect in standalone mode (installed PWA), not in a browser tab.
PWA_ORIENTATION=any
# INSTANCE_WEB_DIR=./instance/web    # default; uncomment to customize

# --- Cloudflared named tunnel (optional, D-94) ---
# Exposes the web container at a public hostname via Cloudflare edge —
# automatic HTTPS, no DNS/port-forwarding, works behind NAT. Enables PWA
# install on iPhone/iPad and access outside the local network.
#
# Setup:
#   1. Cloudflare account (free in zero-trust > tunnels)
#   2. Create a tunnel in the dashboard, configure a public hostname pointing
#      at http://web:8090 (`web` is the internal compose service name).
#   3. Copy the connector token and paste it below.
#   4. `docker compose --profile tunnel up -d cloudflared`
#
# Without the token the service does not come up (compose ignores services
# outside the profile).
CF_TUNNEL_TOKEN=

# To include cloudflared automatically in every `docker compose up -d`
# (without passing `--profile tunnel` each time), uncomment:
# COMPOSE_PROFILES=tunnel
