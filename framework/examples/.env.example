# Copie para .env na raiz do repo e preencha.
# Nao comitar .env.

# --- Postgres (storage unico: messaging, memory, telemetry, orchestrator, web) ---
POSTGRES_DB=agent_framework
POSTGRES_USER=agent_framework
POSTGRES_PASSWORD=

# --- Admin (humano principal da instancia) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=            # plaintext; web bcrypta no startup. Setar pra usar login.

# --- PWA auth ---
# DEV: 1 mantem admin implicito quando nao ha cookie/token (single-user local).
# PROD: deixe vazio + ADMIN_PASSWORD setado pra forcar login.
WEB_AUTH_DEV_BYPASS=1
# Cookies marcados Secure (=requer HTTPS). Setar 1 quando servir com TLS.
WEB_COOKIE_SECURE=

# Stream pre-selecionada no CapturePanel do PWA (dropdown de destino). Nome
# arbitrario da instancia (ex: coordenador, secretario, ops). Vazio = usuario
# escolhe explicitamente; o frontend nao pre-seleciona nada.
WEB_DEFAULT_STREAM=

# --- Service tokens (auth dos daemons internos no broker) ---
ORCHESTRATOR_TOKEN=        # gerado no bootstrap (openssl rand -hex 32)
SCHEDULER_TOKEN=

# --- VAPID (web push) — gere via framework/scripts/generate-vapid.py ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Transcriber (opcional; ajuste conforme GPU/CPU) ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=

# --- Timezone aplicado a todos os containers ---
TZ=America/Sao_Paulo

# --- Deploy: multi-empresa na mesma maquina ---
# Cada empresa = 1 pasta independente (cópia do framework) com o proprio .env.
# COMPOSE_PROJECT_NAME namespaceia containers/volumes/redes — permite rodar
# varias empresas lado a lado sem colisao. WEB_PORT tem que ser unico por empresa.
# Exemplo com 3 empresas: company-agents-a/:9090, -b/:9091, -c/:9092.
COMPOSE_PROJECT_NAME=company-agents
WEB_PORT=9090

# --- BYOI / Docker config (registry privado) ---
# Se algum agente usa `image:` de registry privado, isola credenciais por empresa
# apontando DOCKER_CONFIG pra um diretorio local. Evita colisao com outras contas
# logadas no mesmo registry em ~/.docker/config.json.
#
# Setup: mkdir .docker && DOCKER_CONFIG=./.docker docker login <registry>
# O install.sh faz isso automaticamente se voce responder que usa BYOI.
DOCKER_CONFIG=

# --- Repos (workspace de codigo consumido pelos agentes) ---
# Path no host que o framework monta em /workspace/repos dentro dos containers.
# Por default aponta pra uma pasta dentro de instance/, mas o padrao recomendado
# e deixar os repos FORA do framework (ex: ../gitlab, /var/repos, /mnt/nfs/repos)
# pra evitar aninhar multiplos gits num mesmo workspace do editor.
REPOS_DIR=./instance/repos

# --- Sessions (cwd runtime por topic/task de cada agente) ---
# Cada agente roda em /workspace/sessions/<topic-slug>/ dentro do container —
# briefing, dados intermediarios e artefatos finais ficam ai amarrados a task.
# Layout no host: ${SESSIONS_DIR}/<agent-name>/<topic-slug>/. Pode apontar pra
# fora do framework (disco separado, volume montado) se quiser persistir os
# workspaces de execucao em outro lugar — o web container monta esse path em
# read-only pra servir os arquivos no PWA.
SESSIONS_DIR=./instance/sessions

# --- MySQL de producao (opcional) ---
# Credenciais read-only consumidas via capability_instance MySQL declarada
# em instance/agents/agents.yaml (template `mysql`, runs stdio in-process
# via @benborla29/mcp-server-mysql). Preencha apenas se algum agente
# declarar uma capability_instance que mapeia esses vars no env.
DB_PROD_HOST=
DB_PROD_PORT=3306
DB_PROD_USER=
DB_PROD_PASS=
DB_PROD_NAME=

# --- Git push / MR-PR (usados por executores e revisor-testador) ---
# Injetadas em todos os agentes pelo reconcile. Agentes consultivos simplesmente
# nao invocam git push — disciplina fica no CLAUDE.md de cada agente. Imagem
# do agente ja traz `glab` (GitLab) e `gh` (GitHub) pre-instalados, entao o
# framework e agnostico: configure o token do host que sua instancia usa.
#
# GITLAB_TOKEN: personal access token com scope `api` + `write_repository`
# GITLAB_HOST:  omita se gitlab.com; preencha se self-hosted (ex: gitlab.empresa.com)
# GH_TOKEN:     personal access token com scope `repo`
# GIT_AUTHOR_*: identidade usada nos commits criados por agentes
GITLAB_TOKEN=
GITLAB_HOST=
GH_TOKEN=
GIT_AUTHOR_NAME=agent-framework
GIT_AUTHOR_EMAIL=agents@local

# Proteção anti-push-main: ver hooks_defaults em agents.yaml.example + script
# framework/examples/hooks/block-push-main.sh. Bloqueia agentes de fazer push
# direto em main/master via PreToolUse hook do Claude Code — push do host nao
# e afetado (D-60, substitui git pre-push hooks removidos).

# --- Test mode: CLAUDE_MOCK=1 faz claude_runner devolver reply scriptado
# (sem invocar Claude CLI). CLAUDE_MOCK_REPLY customiza o texto. Usado pela
# suite Playwright (make test-e2e). Vazio em producao. ---
CLAUDE_MOCK=
CLAUDE_MOCK_REPLY=

# --- Stream agregador de notificacoes terminais de task
# (done/halt/human_review). Nome arbitrario da instancia (ex: orquestracao,
# ops, tasks-feed). Vazio = reactor posta apenas na conversa de origem da
# task; o stream agregador nao existe. Quando definido, web bootstrap cria
# o stream no postgres. ---
TERMINAL_NOTIFY_STREAM=

# --- Agentes (token por agente, preenchido pelo reconcile) ---
# AGENT_<NAME>_TOKEN=

# --- PWA (Progressive Web App) — manifest dinamico (D-94) ---
# Configuracao da app quando instalada no dispositivo (iOS Add to Home,
# Chrome Install). Lido pelo container `web` em runtime; mudar requer
# `docker compose restart web` (sem rebuild).
#
# Icones: drope `icon-192.png` e `icon-512.png` em
# `${INSTANCE_WEB_DIR}/icons/` (default: `./instance/web/icons/`).
# Pra apontar pra outro lugar (ex: ficar dentro do `company/` da
# instancia), redefina `INSTANCE_WEB_DIR=./company/web` no .env.
PWA_NAME=Agents
PWA_SHORT_NAME=Agents
PWA_DESCRIPTION=Multi-agent orchestration
PWA_THEME_COLOR=#0b1220
PWA_BACKGROUND_COLOR=#0b1220
PWA_ID=/agent-framework
PWA_LANG=en
PWA_START_URL=/
# Orientacao quando o PWA instalado abre. Valores: any (default),
# portrait, landscape, portrait-primary, landscape-primary, natural.
# Pra travar mobile no formato pe-em-pe: PWA_ORIENTATION=portrait.
# So tem efeito em standalone (PWA instalado), nao em aba do browser.
PWA_ORIENTATION=any
# INSTANCE_WEB_DIR=./instance/web    # default; descomente pra customizar

# --- Cloudflared named tunnel (opcional, D-94) ---
# Expoe o web container num hostname publico via Cloudflare edge — HTTPS
# automatico, sem DNS/port-forward, funciona atras de NAT. Habilita PWA
# install em iPhone/iPad e acesso fora da rede local.
#
# Setup:
#   1. Conta Cloudflare (gratis em zero-trust > tunnels)
#   2. Cria tunnel no dashboard, configura public hostname apontando pra
#      http://web:8090 (esse `web` e o nome do service interno do compose).
#   3. Copia o connector token e cola abaixo.
#   4. `docker compose --profile tunnel up -d cloudflared`
#
# Sem o token o servico nao sobe (compose ignora o servico fora do profile).
CF_TUNNEL_TOKEN=

# Pra incluir o cloudflared automaticamente em todo `docker compose up -d`
# (sem precisar passar `--profile tunnel` toda vez), descomente:
# COMPOSE_PROFILES=tunnel
