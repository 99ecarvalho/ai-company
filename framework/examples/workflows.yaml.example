# workflows.yaml.example — MINIMAL annotated TEMPLATE for your company.
#
# Copy this to instance/company/workflows.yaml, edit, and you're set — the
# framework reloads on every complete_phase (no restart needed).
#
# === What is this? ===
#
# agent-framework is vocabulary-agnostic. Each company declares here its own
# steps (free-form names, in any language), default agents per step, the
# artifacts produced, and the valid transitions. The framework loads this at
# runtime and validates `complete_phase` calls against this declaration.
#
# The framework knows ONLY three terminals with fixed semantics:
#   done          => status=done         (success)
#   halt          => status=blocked      (human needs to unblock)
#   human_review  => status=human_review (human needs to decide direction)
# Any other name is a free-form step, defined here.
#
# === How does a task bind to a workflow? ===
#
# On the first `complete_phase` call for a new task, the agent passes
# `workflow: <name>` (e.g. `workflow: default`) together with `title`. The
# framework persists this in `tasks.tasks.workflow` and, from there on, every
# complete_phase consults this file to validate the transition and resolve
# the next step's agent. If `workflow` was not provided — or doesn't match
# anything here — the framework runs in **permissive mode**: accepts any
# step, but requires an explicit `next_agent` on every complete_phase.
#
# === Per-step schema ===
#
#   agent:    (optional) default agent that runs this step. If omitted,
#             complete_phase pointing here requires an explicit `next_agent`
#             (useful when multiple agents can run the same step — e.g.
#             a "build" step with multiple executors per stack/language).
#   artifact: (optional) name of the file the agent produces in this step.
#             Injected in the handoff prompt ("look for X in the task").
#   next:     list of valid next steps/terminals. complete_phase rejects
#             transitions to any destination not in this list.

workflows:

  # === EXAMPLE 1: simple default workflow (five steps + terminals) ===
  # Typical linear flow: intake -> plan -> build -> review -> wrap.
  default:
    initial_step: intake
    steps:
      intake:
        agent: triager               # agent that does the initial triage
        artifact: 00-intake.md
        next: [plan, halt, human_review]
      plan:
        agent: planner
        artifact: 01-plan.md
        next: [build, halt, human_review]
      build:
        # `agent` omitted: planner chooses which executor (varies by stack,
        # language, domain). Passes next_agent=<name> in complete_phase.
        artifact: 02-build/README.md
        next: [review, plan, halt, human_review]
      review:
        agent: reviewer
        artifact: 03-review.md
        next: [wrap, build, halt, human_review]
      wrap:
        agent: triager
        artifact: wrap.md
        next: [done]

  # === EXAMPLE 2: short workflow for investigation (no build) ===
  # Useful for questions that end in a document, without code.
  research:
    initial_step: intake
    steps:
      intake:
        agent: triager
        artifact: 00-intake.md
        next: [investigate, halt, human_review]
      investigate:
        agent: researcher
        artifact: 01-findings.md
        next: [wrap, halt, human_review]
      wrap:
        agent: triager
        artifact: wrap.md
        next: [done]
